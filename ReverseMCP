local BOOT_TEMPLATE = [[
do
	local isfileF, readfileF, loadF = isfile, readfile, loadstring
	if typeof(isfileF) ~= "function" or typeof(readfileF) ~= "function" or typeof(loadF) ~= "function" then
		return
	end
	local stateFile = STATE_FILE_NAME
	local sourceCandidates = SOURCE_CANDIDATES
	local okExists, exists = pcall(isfileF, stateFile)
	if not okExists or not exists then return end
	local okRead, content = pcall(readfileF, stateFile)
	if not okRead or type(content) ~= "string" then return end
	if not content:match('"enabled"%s*:%s*true') then return end
	if not content:match('"autoRestart"%s*:%s*true') then return end
	local firstGameId = tonumber(content:match('"gameId"%s*:%s*(-?%d+)') or -1)
	if firstGameId ~= game.GameId then return end
	for _, candidate in ipairs(sourceCandidates) do
		if isfileF(candidate) then
			local okChunk, chunk = pcall(loadF, readfileF(candidate))
			if okChunk and chunk then
				pcall(chunk)
			end
			break
		end
	end
end]]

local function buildBootstrap()
	local candidates = {}
	for _, name in ipairs(CONFIG.SourceCandidates) do
		table.insert(candidates, ('%q'):format(name))
	end
	local candList = "{" .. table.concat(candidates, ",") .. "}"
	local out = BOOT_TEMPLATE:gsub("STATE_CANDIDATES", candList)
	out = out:gsub("STATE_FILE_NAME", ('%q'):format(stateFileName()))
	return out
end

local function queueAutoRestart()
	if (not Capabilities.queue_on_teleport) or (not fsAvailable()) then
		return false
	end
	if not State.autoRestart then
		pcall(queue_on_teleport, "-- ReverseMCP auto-restart disabled")
		return false
	end
	State.gameId = game.GameId
	State.placeId = game.PlaceId
	if not saveState() then return false end
	pcall(queue_on_teleport, buildBootstrap())
	return true
end

