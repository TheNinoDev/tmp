	PollIntervalMs        = 600,              -- file scan cadence, 250 .. 5000 clamp
	StatusRefreshS        = 1.0,
	SessionPingS          = 5,                -- heartbeat rewrite of the session file

	StateFile             = "ReverseMCP.state.%s.json",    -- per-run state (suffix)
	StateFileLegacy       = "ReverseMCP.state.json",         -- pre-multi-session file, imported once
	SourceCandidates      = { "ReverseMCP.client.obfuscated.luau", "ReverseMCP.client.luau" },

