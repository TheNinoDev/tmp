	}
	if char then data.characterPath = pathOf(char) end
	if root then
		local pos = root.Position
		local vel = root.AssemblyLinearVelocity
		data.position = { x = pos.X, y = pos.Y, z = pos.Z }
		data.velocity = { x = vel.X, y = vel.Y, z = vel.Z }
