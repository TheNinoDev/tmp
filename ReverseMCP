function Commands.get_properties(args)
	local inst, err = resolvePath((args and args.path) or "")
	if not inst then return { ok = false, error = err } end
	local requested = args and args.props
	local list = (type(requested) == "table" and requested) or COMMON_PROPS
	local propsOut, attempted, unreadable = {}, 0, 0
	for _, pname in ipairs(list) do
		attempted = attempted + 1
		if attempted > 400 then break end
		local ok, value = pcall(function() return inst[pname] end)
		if ok then
			propsOut[pname] = serializeValue(value, 1, nil, { count = 0, cap = 512 })
		else
			unreadable = unreadable + 1
		end
	end
	return {
		ok = true,
		data = {
			path = pathOf(inst),
			className = inst.ClassName,
			attempted = attempted,
			unreadable = unreadable,
			props = propsOut,
		},
	}
end

local function hexify(text, cap)
	local parts = {}
	for i = 1, math.min(#text, cap) do
		parts[i] = ("%02x"):format(text:byte(i, i))
	end
	return table.concat(parts)
end

function Commands.get_source(args)
	local inst, err = resolvePath((args and args.path) or "")
	if not inst then return { ok = false, error = err } end
	local isOk, isLua = pcall(function() return inst:IsA("LuaSourceContainer") end)
	if not (isOk and isLua) then
		return { ok = false, error = ("instance is %s, not a Lua script container"):format(tostring(inst.ClassName)) }
	end
	if Capabilities.decompile then
		local ok, src = pcall(decompile, inst)
		if ok and type(src) == "string" then
			local truncated = (#src > CONFIG.DecodeSourceCap)
			if truncated then src = src:sub(1, CONFIG.DecodeSourceCap) .. "\n--<truncated>" end
			return { ok = true, data = { via = "decompile", path = pathOf(inst), size = #src, truncated = truncated, source = src } }
		end
	end
	if Capabilities.bytecode then
		local ok, bc = pcall(getscriptbytecode, inst)
		if ok and type(bc) == "string" then
			return { ok = true, data = { via = "bytecode", path = pathOf(inst), size = #bc, truncated = (#bc > CONFIG.DecodeSourceCap), payload_hex = hexify(bc, CONFIG.DecodeSourceCap) } }
		end
	end
	return { ok = false, error = "executor exposes neither decompile() nor getscriptbytecode()" }
end

function Commands.remote_spy(args)
	local mode = (args and type(args.mode) == "string") and args.mode or "status"
	local output
	if mode == "on" then
		if args and type(args.incoming) == "boolean" then State.incoming = args.incoming end
		local result = spyStart()
		output = { hooked = result.hooked, incomingAttached = result.attached, incoming = State.incoming }
	elseif mode == "off" then
		spyStop()
		output = { hooked = Spy.hooked, incoming = State.incoming }
	else
		local listenerCount = 0
		for _ in pairs(Spy.incoming) do listenerCount = listenerCount + 1 end
		output = {
			enabled   = State.spy,
			hooked    = Spy.hooked,
			incoming  = State.incoming,
			listeners = listenerCount,
			buffer    = #Spy.buffer,
			total     = Spy.total,
		}
	end
	return { ok = true, data = output }
end

function Commands.remote_calls(args)
	local limit = clamp((args and args.limit) or 50, 1, CONFIG.RemoteBufferCap)
	local sinceId = tonumber((args and args.sinceId) or 0) or 0
	local kind = (args and type(args.kind) == "string") and args.kind or ""
	local search = ((args and type(args.search) == "string") and args.search or ""):lower()

	local out = {}
	for i = #Spy.buffer, 1, -1 do
		if #out >= limit then break end
		local rec = Spy.buffer[i]
		local clsMatch = (kind == "") or (rec.dir == kind)
		local pathMatch = (search == "") or (rec.path:lower():find(search, 1, true) ~= nil)
		if rec.id > sinceId and clsMatch and pathMatch then
			table.insert(out, rec)
		end
	end
	local cleared = false
	if args and args.clear == true then
		table.clear(Spy.buffer)
		cleared = true
	end
	return { ok = true, data = { total = Spy.total, count = #out, records = out, cleared = cleared } }
end

local function decodeArgValue(v, depth)
	if depth > (CONFIG.ArgDepth or 4) then return nil end
	if typeof(v) ~= "table" then return v end

	if v.t == "instance" or v.t == "Instance" then
		local inst = (type(v.path) == "string") and resolvePath(v.path) or nil
		return inst
	elseif v.t == "Vector3" then
		return Vector3.new(tonumber(v.x) or 0, tonumber(v.y) or 0, tonumber(v.z) or 0)
	elseif v.t == "Vector2" then
		return Vector2.new(tonumber(v.x) or 0, tonumber(v.y) or 0)
	elseif v.t == "CFrame" and type(v.pos) == "table" then
		return CFrame.new(tonumber(v.pos.x) or 0, tonumber(v.pos.y) or 0, tonumber(v.pos.z) or 0)
	elseif v.t == "Color3" then
		return Color3.new(tonumber(v.r) or 0, tonumber(v.g) or 0, tonumber(v.b) or 0)
	elseif v.t == "EnumItem" then
		-- serializeValue stores tostring(emi) which is "EnumType.Item" or "Enum.EnumType.Item"
		local fullName = tostring(v.name or "")
		local parts = fullName:split(".")
		local enumName, itemName
		if parts[1] == "Enum" then
			enumName, itemName = parts[2], parts[3]
		else
			enumName, itemName = parts[1], parts[2]
		end
		if (not itemName) and type(v.enumType) == "string" then
			-- fall back to the recorded enum type ("Enum.Material")
			local fromType = v.enumType:gsub("^Enum%.", "")
			if fromType and #fromType > 0 then enumName = fromType end
			local fromName = fullName:match("%w+%.([%w_%s]+)$")
			if fromName then itemName = fromName end
		end
		if not enumName or not itemName then return nil end
		local enumTable = Enum[enumName]
		if not enumTable then return nil end
		return enumTable[itemName]
	elseif (v.t == "number" or v.t == "string") and type(v.repr) == "string" then
		return tostring(v.repr)
	elseif v.t == "boolean" and v.repr ~= nil then
		return (tostring(v.repr) == "true")
	elseif v.t ~= nil and v.t ~= "table" then
		-- opaque / non-replayable value: surface its textual form
		return tostring(v.repr or v.t)
	end

	-- plain structural table (v.t may be nil, or "table")
	if v.t == "table" and (v.cycle == true or v.truncated == true) then
		return {}
	end
	local len = #v
	local isArr = (len > 0) and (v[1] ~= nil) and (next(v, len) == nil)
	local out = {}
	if isArr then
		for i = 1, len do
			out[i] = decodeArgValue(v[i], depth + 1)
		end
		return out
	end
	for k, subv in pairs(v) do
		if k == "t" then
			-- serialized wrapper meta — skip
		elseif type(k) == "number" or type(k) == "string" then
			out[k] = decodeArgValue(subv, depth + 1)
		end
	end
	return out
end

function Commands.call_remote(args)
	if not State.allowRemoteAdds then
		return { ok = false, error = "remote calls are disabled in the game UI ('Allow remote calls')" }
	end
	local inst, err = resolvePath((args and args.path) or "")
	if not inst then return { ok = false, error = err } end
	local cls = inst.ClassName
	local method = (args and type(args.method) == "string" and args.method ~= "") and args.method or ""
	if method == "" then
		method = (cls == "RemoteFunction") and "InvokeServer" or "FireServer"
	end
	local allowed = (cls == "RemoteEvent" and method == "FireServer")
		or (cls == "UnreliableRemoteEvent" and method == "FireServer")
		or (cls == "RemoteFunction" and method == "InvokeServer")
	if not allowed then
		return { ok = false, error = ("class %s does not expose %s"):format(cls, method) }
	end
	local rawArgs = (args and type(args.args) == "table") and args.args or {}
	local finalArgs = {}
	for _, argv in ipairs(rawArgs) do
		table.insert(finalArgs, decodeArgValue(argv, 0))
	end
	local okCall, resultsPack = pcall(function()
		return table.pack(inst[method](table.unpack(finalArgs)))
	end)
	if not okCall or typeof(resultsPack) ~= "table" then
		return { ok = false, error = "call failed: " .. tostring(resultsPack) }
	end
	local out = {}
	for i = 1, resultsPack.n do
		out[i] = serializeValue(resultsPack[i], 0, nil, { count = 0, cap = 512 })
	end
	return {
		ok = true,
		data = {
			path        = pathOf(inst),
			class       = cls,
			method      = method,
			results     = out,
			resultCount = resultsPack.n,
		},
	}
end

function Commands.logs(args)
	local limit = clamp((args and args.limit) or 80, 1, 400)
	local okHistory, history = pcall(function() return LogService:GetLogHistory() end)
	if not okHistory or type(history) ~= "table" then
		return { ok = false, error = "LogService:GetLogHistory unavailable" }
	end
	local out = {}
	for i = math.max(1, #history - limit + 1), #history do
		local entry = history[i]
		table.insert(out, {
			t       = entry.time,
			kind    = tostring(entry.messageType),
			message = (type(entry.message) == "string" and entry.message:sub(1, 800)) or tostring(entry.message),
		})
	end
	return { ok = true, data = { count = #out, logs = out } }
end

function Commands.luau(args)
	if not State.allowInterpret then
		return { ok = false, error = "interpreter disabled in the game UI ('Allow interpreter')" }
	end
	local code = (args and args.code) or ""
	if type(code) ~= "string" or #code == 0 then return { ok = false, error = "code string required" } end
	local chunkFn, diag = loadstring(code)
	if not chunkFn then return { ok = false, error = "compile error: " .. tostring(diag) } end
	local okRun, firstResult = pcall(chunkFn)
	if not okRun then return { ok = false, error = "runtime: " .. tostring(firstResult) } end
	local serialized = serializeValue(firstResult, 0, nil, { count = 0, cap = 4096 })
	return { ok = true, data = { result = serialized } }
end

