local PLAYBOOK_TEMPLATE = [==[
# ReverseMCP — controlling the live Roblox game run (zero node, zero server)
#
# The game run announces itself as a file named:
#   {SES}
# inside the executor's workspace folder. That file carries the run uuid,
# executor name, placeId/gameId and a paused flag. One rule: the command
# envelope below is dropped as "{CMD}", the run answers via "{RES}".
#
# fn must be one of:
#   status game_info players my_player explore search_instances
#   get_properties get_source remote_spy remote_calls call_remote logs luau
#
# 0) Find the run (one-time; the folder of the session file is <dir>):
Get-ChildItem "$env:USERPROFILE\Documents","$env:APPDATA","$env:LOCALAPPDATA","D:\","C:\" -Depth 6 -Filter "{SES}" -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 5 FullName

# 1) Run a tool (example: explore). Replace <dir> with the folder from step 0:
$dir="<dir>"
@{ rpc="rmcp-rpc-1"; id=[guid]::NewGuid().ToString("N"); fn="explore"; args=@{ path="game.Workspace"; depth=3; maxNodes=800 } } | ConvertTo-Json -Depth 10 -Compress | Set-Content -LiteralPath "$dir\{CMD}" -Encoding UTF8

# 2) Read the answer (usually ready in under a second):
Get-Content -LiteralPath "$dir\{RES}" -Raw

# Answer shape: { "rpc":..., "id":..., "ok":true/false, "data":... or "error":..., "session":..., "time":... }
# - ok=false -> read "error" (e.g. 'MCP paused: toggled off in the game UI').
# - One command at a time; new envelope replaces the old one; the run dedupes by id.
# - Several games open at once -> one session/cmd/res trio per run (suffix in the
#   file name); the "session" field of the answer echoes exactly which run replied.
#
# Gate notices from the game UI:
#   - call_remote refuses while 'Allow remote calls' is off in the game window.
#   - luau refuses while 'Allow interpreter' is off.
]==]

local KICKOFF = [==[
I am inside a Roblox game with ReverseMCP running (file channel: no node, no server).
Step 0: find my run — locate the newest ReverseMCP.session.*.json with PowerShell (playbook below). Its folder is <dir>; the file contains the run uuid.
Step 1: drop the command envelope for fn="status" exactly as the playbook shows, then read the result file. If ok=false or nothing arrives, tell me (game window may be paused; 'MCP On/Off' toggle in the Reverse MCP window).
Step 2: run fn="game_info" and summarize the experience (place name/id, universe, creator, player count) in two lines.
Step 3: follow my further instructions on what to reverse in this game — instances, remotes, scripts, players — using the tools from the playbook.
Careful: 'call_remote' performs real game traffic; use it only when I explicitly confirm.]==]

local function filePlaybook()
	return PLAYBOOK_TEMPLATE
		:gsub("%{CMD%}", cmdFileName())
		:gsub("%{RES%}", resFileName())
		:gsub("%{SES%}", sessionFileName())
end

local function buildSnippet(client)
	local hint = CLIENT_HINTS[client] or "Paste into the chat or the agent instructions file of your client."
