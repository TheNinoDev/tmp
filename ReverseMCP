local function executorLabel()
	if Capabilities.identifier then
		local ok, v = pcall(function() return identifyexecutor() end)
		if ok and type(v) == "string" and #v > 0 then return v end
	end
	return "unknown executor"
end

local EXECUTOR = executorLabel()

