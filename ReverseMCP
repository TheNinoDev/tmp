local State = {
	running         = false,
	enabled         = CONFIG.Defaults.Master,
	spy             = CONFIG.Defaults.Spy,
	incoming        = CONFIG.Defaults.Incoming,
	allowRemoteAdds = CONFIG.Defaults.AllowRemoteAdds,
	allowInterpret  = CONFIG.Defaults.AllowInterpret,
	autoRestart     = CONFIG.Defaults.AutoRestart,
	pollMs          = CONFIG.PollIntervalMs,
	token           = nil,
	suffix          = nil,
	gameId          = 0,
	placeId         = 0,
}

-- per-run file names derived from the run uuid's short suffix — this is what
-- lets several executor runs (several games / windows) live side by side
local function sessionSuffix()
	if State.suffix then return State.suffix end
	local h = 2166136261
	for i = 1, #State.token do
		h = h * 31 + string.byte(State.token, i)
		h = h % 4294967296
	end
	State.suffix = ("%08x"):format(h)
	return State.suffix
end

local function cmdFileName()     return CONFIG.CmdFile:format(sessionSuffix()) end
local function resFileName()     return CONFIG.ResFile:format(sessionSuffix()) end
local function sessionFileName() return CONFIG.SessionFile:format(sessionSuffix()) end
local function stateFileName()   return CONFIG.StateFile:format(sessionSuffix()) end

local Session = {
	joinTime        = os.time(),
	teleportHistory = {},
}

local UI = {}

--------------------------------------------------------------------
-- STATE FILE -------------------------------------------------------
--------------------------------------------------------------------

local function fsAvailable()
	return Capabilities.filesystem == true
end

local function saveState()
	if not fsAvailable() then return false end
	local blob = {
		version     = VERSION,
		uuid        = State.token,
		suffix      = sessionSuffix(),
		transport   = "file",
		enabled     = State.enabled,
		spy         = State.spy,
		incoming    = State.incoming,
		allowRemote = State.allowRemoteAdds,
		allowInterp = State.allowInterpret,
		autoRestart = State.autoRestart,
		pollMs      = State.pollMs,
		gameId      = State.gameId or 0,
		placeId     = State.placeId or 0,
		executor    = EXECUTOR,
	}
	local ok, payload = pcall(function() return HttpService:JSONEncode(blob) end)
	if not ok or type(payload) ~= "string" then return false end
	return pcall(writefile, stateFileName(), payload)
end

local function loadState()
	if not fsAvailable() then return end
	-- legacy single-session file: import once, then move on to per-run naming
	local sourceName = nil
	local okL1, exists1 = pcall(isfile, stateFileName())
	if okL1 and exists1 then
		sourceName = stateFileName()
	else
		local okL2, exists2 = pcall(isfile, CONFIG.StateFileLegacy)
		if okL2 and exists2 then sourceName = CONFIG.StateFileLegacy end
	end
	if not sourceName then return end
	local okR, content = pcall(readfile, sourceName)
	if not okR or type(content) ~= "string" then return end
	local okD, decoded = pcall(HttpService.JSONDecode, HttpService, content)
	if not okD or type(decoded) ~= "table" then return end
	if type(decoded.enabled) == "boolean" then State.enabled = decoded.enabled end
	if type(decoded.spy) == "boolean" then State.spy = decoded.spy end
	if type(decoded.incoming) == "boolean" then State.incoming = decoded.incoming end
	if type(decoded.allowRemote) == "boolean" then State.allowRemoteAdds = decoded.allowRemote end
	if type(decoded.allowInterp) == "boolean" then State.allowInterpret = decoded.allowInterp end
	if type(decoded.autoRestart) == "boolean" then State.autoRestart = decoded.autoRestart end
	if type(decoded.pollMs) == "number" and decoded.pollMs >= 250 and decoded.pollMs <= 5000 then
		State.pollMs = math.floor(decoded.pollMs)
	end
	if type(decoded.token) == "string" and #decoded.token >= 8 and #decoded.token <= 96 then
		State.token = decoded.token
	elseif type(decoded.uuid) == "string" and #decoded.uuid >= 8 and #decoded.uuid <= 96 then
		State.token = decoded.uuid
	end
	if type(decoded.gameId) == "number" then State.gameId = decoded.gameId end
	if type(decoded.placeId) == "number" then State.placeId = decoded.placeId end
end

local function newSessionToken()
	local bytes = {}
	for i = 1, 16 do
		table.insert(bytes, ("0123456789abcdef"):sub(math.random(1, 16), math.random(1, 16)))
	end
	return ("rmcp-%d-%s"):format(os.time(), table.concat(bytes))
end

if not State.token then
	State.token = newSessionToken()
end

loadState()

-- teleport detection: previous state file placeId != current placeId (same universe)
if State.placeId ~= 0 and State.placeId ~= game.PlaceId and State.gameId == game.GameId then
	table.insert(Session.teleportHistory, { t = os.time(), from = State.placeId, to = game.PlaceId })
	if #Session.teleportHistory > 20 then
		table.remove(Session.teleportHistory, 1)
	end
end

-- zero-fill: a fresh install stores the real place/universe ids so the
-- teleport bootstrap matches immediately (without this the launch check
-- would compare 0 against the live GameId and silently refuse to boot)
if State.gameId == 0 then State.gameId = game.GameId end
if State.placeId == 0 then State.placeId = game.PlaceId end
saveState()

--------------------------------------------------------------------
-- PATH HELPERS -----------------------------------------------------
--------------------------------------------------------------------

local function plainIdentifier(n)
	return type(n) == "string" and #n > 0 and n:match("[^%w_]") == nil and n:sub(1, 1):match("%d") == nil
end

local function quoteSegment(name)
	if plainIdentifier(name) then
		return "." .. name
	end
	local esc = tostring(name)
		:gsub("\\", "\\\\")
		:gsub('"', '\\"')
		:gsub("\n", "\\n")
		:gsub("\r", "\\r")
		:gsub("\t", "\\t")
	return ('["%s"]'):format(esc)
end

local function pathOf(inst)
	if typeof(inst) ~= "Instance" then return nil end
	if inst == game then return "game" end
	local parts = {}
	local cur = inst
	while typeof(cur) == "Instance" do
		table.insert(parts, 1, quoteSegment(cur.Name))
		if cur.Parent == game or cur.Parent == nil then break end
		cur = cur.Parent
	end
	if #parts == 0 then return nil end
	return "game" .. table.concat(parts, "")
end

local function readBracketSegment(text, pos)
	-- expects text:sub(pos,pos) == '['
	if text:sub(pos, pos) ~= "[" then return nil, pos end
	local j = pos + 1
	local first = text:sub(j, j)
	if first == '"' then
		local inner = {}
		j = j + 1
		while j <= #text do
			local ch = text:sub(j, j)
			if ch == "\\" and j < #text then
				local nx = text:sub(j + 1, j + 1)
				if nx == "n" then ch = "\n"
				elseif nx == "r" then ch = "\r"
				elseif nx == "t" then ch = "\t"
				elseif nx == "\\" then ch = "\\"
				elseif nx == '"' then ch = '"'
				else ch = nx end
				table.insert(inner, ch)
				j = j + 2
			elseif ch == '"' then
				return table.concat(inner), j + 2   -- skip closing " and ]
			else
				table.insert(inner, ch)
				j = j + 1
			end
		end
		return nil, #text + 1
	end
	local digits = text:sub(j, j + 12):match("^%d+")
	if digits then
		return digits, j + #digits + 1
	end
	return nil, j + 1
end

local function resolvePath(text)
	if type(text) ~= "string" then return nil, "path must be a string" end
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	if text == "" then return nil, "empty path" end

	local head, endPos = nil, 1
	while endPos <= #text do
		local ch = text:sub(endPos, endPos)
		if ch:match("[%w_]") == nil then break end
		endPos = endPos + 1
	end
	head = text:sub(1, endPos - 1)

	local cur
	local i = endPos
	if head == "game" then
		cur = game
		if text:sub(i, i) == "." then i = i + 1 end
	elseif head == "workspace" or head == "Workspace" then
		cur = workspaceRef
		if text:sub(i, i) == "." then i = i + 1 end
	else
		return nil, "path must start with 'game.' or 'workspace.'"
	end

	local firstSegment = true
	while i <= #text do
		local ch = text:sub(i, i)
		local seg
		if ch == "." then
			local e = i + 1
			while e <= #text do
				local c2 = text:sub(e, e)
				if c2:match("[%w_]") == nil then break end
				e = e + 1
			end
			seg = text:sub(i + 1, e - 1)
			i = e
		elseif ch == "[" then
			local value, nextI = readBracketSegment(text, i)
			if value == nil then
				return nil, ("unreadable bracket token at position %d in %s"):format(i, text)
			end
			seg = value
			i = nextI
		else
			return nil, ("unexpected character '%s' at position %d in %s"):format(ch, i, text)
		end
		-- container names are case-sensitive; accept any casing of the root
		-- workspace node ("game.workspace", "game.Workspace", "game['workspace']")
		if firstSegment and cur == game and seg:lower() == "workspace" then
			cur = workspaceRef
			firstSegment = false
		else
			firstSegment = false
			if typeof(cur) ~= "Instance" then
				return nil, ("path reaches a nil parent at segment '%s'"):format(tostring(seg))
			end
			local next_inst = cur:FindFirstChild(seg)
			if next_inst == nil then
				return nil, ("'%s' not found under %s"):format(tostring(seg), pathOf(cur) or "<root>")
			end
			cur = next_inst
		end
	end

	return cur
end

--------------------------------------------------------------------
-- SERIALIZATION ----------------------------------------------------
--------------------------------------------------------------------

local function serializeValue(value, depth, visited, budget)
	depth = depth or 0
	visited = visited or {}
	budget = budget or { count = 0, cap = 512 }

	if budget.count >= budget.cap then
		return { t = "limit", repr = "<serialization cap reached>" }
	end
	budget.count = budget.count + 1

	local ty = typeof(value)
	if value == nil then
		return nil
	elseif ty == "number" then
		if value ~= value then return { t = "number", repr = "nan" } end
		if value == math.huge or value == -math.huge then return { t = "number", repr = tostring(value) } end
		return value
	elseif ty == "string" then
		if #value > 12000 then
			return { t = "string", truncated = true, repr = value:sub(1, 12000) .. "..." }
		end
		return value
	elseif ty == "boolean" then
		return value
	elseif ty == "Instance" then
		return { t = "Instance", path = pathOf(value) or "<detached>", name = value.Name, className = value.ClassName }
	elseif ty == "Vector3" then
		return { t = "Vector3", x = value.X, y = value.Y, z = value.Z }
	elseif ty == "Vector2" then
		return { t = "Vector2", x = value.X, y = value.Y }
	elseif ty == "CFrame" then
		return {
			t     = "CFrame",
			pos   = { x = value.Position.X, y = value.Position.Y, z = value.Position.Z },
			look  = { x = value.LookVector.X, y = value.LookVector.Y, z = value.LookVector.Z },
			right = { x = value.RightVector.X, y = value.RightVector.Y, z = value.RightVector.Z },
		}
	elseif ty == "Color3" then
		local okHex, hex = pcall(function() return value:ToHex() end)
		return { t = "Color3", r = value.R, g = value.G, b = value.B, hex = (okHex and hex) or nil }
	elseif ty == "ColorSequence" then
		local keypoints = {}
		for i, kp in ipairs(value.Keypoints) do
			keypoints[i] = { time = kp.Time, hex = kp.Value:ToHex() }
		end
		return { t = "ColorSequence", keypoints = keypoints }
	elseif ty == "UDim2" then
		return { t = "UDim2", x = { scale = value.X.Scale, offset = value.X.Offset }, y = { scale = value.Y.Scale, offset = value.Y.Offset } }
	elseif ty == "Enum" then
		return { t = "Enum", repr = tostring(value) }
	elseif ty == "EnumItem" then
		return { t = "EnumItem", name = tostring(value), value = value.Value, enumType = tostring(value.EnumType) }
	elseif ty == "table" then
		if depth >= CONFIG.ArgDepth then
			return { t = "table", truncated = true, depth = depth }
		end
		if visited[value] then return { t = "table", cycle = true } end
		visited[value] = true

		local n, maxI = 0, 0
		local isList = true
		for k, _ in pairs(value) do
			n = n + 1
			if type(k) == "number" and k > maxI then maxI = k end
			if type(k) ~= "number" or k <= 0 or k % 1 ~= 0 then isList = false end
		end
		if isList and n ~= maxI then isList = false end

		if isList then
			local out = {}
			local lim = math.min(maxI, 64)
			for i = 1, lim do
				out[i] = serializeValue(value[i], depth + 1, visited, budget)
				if budget.count >= budget.cap then break end
			end
			return out
		end

		local out = {}
		local seen = 0
		for k, v in pairs(value) do
			seen = seen + 1
			if seen > 64 then break end
			out[(type(k) == "string" and plainIdentifier(k)) and k or tostring(k)] = serializeValue(v, depth + 1, visited, budget)
			if budget.count >= budget.cap then break end
		end
		return out
	else
		return { t = tostring(ty), repr = tostring(value) }
	end
end

local function jsonEscapeContent(s)
	local out = {}
	for i = 1, #s do
		local b = string.byte(s, i)
		if b == 34 then table.insert(out, '\\"')
		elseif b == 92 then table.insert(out, "\\\\")
		elseif b == 10 then table.insert(out, "\\n")
		elseif b == 13 then table.insert(out, "\\r")
		elseif b == 9 then table.insert(out, "\\t")
		elseif b < 32 then table.insert(out, ("\\u%04x"):format(b))
		else table.insert(out, string.sub(s, i, i)) end
	end
	return table.concat(out, "")
end

local function jsonEncode(v)
	local ty = type(v)
	if v == nil then return "null" end
	if ty == "number" then
		if v ~= v or v == math.huge or v == -math.huge then return "0" end
		return ("%.14g"):format(v)
	elseif ty == "string" then
		return '"' .. jsonEscapeContent(v) .. '"'
	elseif ty == "boolean" then
		return v and "true" or "false"
	elseif ty == "table" then
		local n, maxI = 0, 0
		local isList = true
		for k, _ in pairs(v) do
			n = n + 1
			if type(k) == "number" and k > maxI then maxI = k end
			if type(k) ~= "number" or k <= 0 or k % 1 ~= 0 then isList = false end
		end
		if n == 0 then return "{}" end
		if isList and n == maxI then
			local parts = {}
			for i = 1, n do parts[i] = jsonEncode(v[i]) end
			return "[" .. table.concat(parts, ",") .. "]"
		end
		local parts = {}
		for k, val in pairs(v) do
			table.insert(parts, jsonEncode(tostring(k)) .. ":" .. jsonEncode(val))
		end
		return "{" .. table.concat(parts, ",") .. "}"
	else
		return jsonEncode(tostring(v))
	end
end

local function serJSON(value, cap)
	return jsonEncode(serializeValue(value, 0, nil, { count = 0, cap = cap or 4096 }))
end

--------------------------------------------------------------------
-- REMOTE SPY (headless SimpleSpy-concept) --------------------------
--------------------------------------------------------------------

local Spy = {
	hooked       = false,
	origNamecall = nil,
	hookWrapper  = nil,
	incoming     = {},   -- instance -> connection object (or {invoke=true} marker)
	invokeCbs    = {},   -- entries {inst=..., prev=oldCallback}
	buffer       = {},   -- ring buffer of records
	nextId       = 1,
	total        = 0,
}

local OUTBOUND_METHODS = {
	FireServer     = true,
	InvokeServer   = true,
	FireAllClients = true,
	FireClient     = true,
	InvokeClient   = true,
}

local SPY_CLASSES = {
	RemoteEvent           = true,
	RemoteFunction        = true,
	UnreliableRemoteEvent = true,
}

local function spyRecord(dir, inst, method, argsTable)
	if #Spy.buffer >= CONFIG.RemoteBufferCap then
		table.remove(Spy.buffer, 1)
	end
	local caller
	if Capabilities.getcallingscript then
		local ok, s = pcall(getcallingscript)
		if ok and typeof(s) == "Instance" then caller = pathOf(s) end
	end
	local budget = { count = 0, cap = 2048 }
	local argsOut = {}
	for i = 1, math.min(#argsTable, 16) do
		argsOut[i] = serializeValue(argsTable[i], 0, nil, budget)
		if budget.count >= budget.cap then break end
	end
	local rec = {
		id     = Spy.nextId,
		t      = os.time(),
		dir    = dir,
		path   = pathOf(inst) or "<detached>",
		cls    = (typeof(inst) == "Instance" and inst.ClassName) or "?",
		method = method,
		args   = argsOut,
		caller = caller,
	}
	Spy.nextId = Spy.nextId + 1
	Spy.total = Spy.total + 1
	table.insert(Spy.buffer, rec)
end

local function hookNamecall()
	if Spy.hooked then return true end
	if not Capabilities.hookmetamethod then return false end

	local hookBody
	hookBody = function(...)
		-- executor calls the metamethod with self as the first argument
		local args = { ... }
		local method = getnamecallmethod()
		local self = args[1]
		if typeof(self) == "Instance" and SPY_CLASSES[self.ClassName] and type(method) == "string" and OUTBOUND_METHODS[method] then
			local recArgs = {}
			for i = 2, #args do recArgs[i - 1] = args[i] end
			pcall(spyRecord, "Outgoing", self, method, recArgs)
		end
		return Spy.origNamecall(self, table.unpack(args, 2))
	end

	local wrapped
	if Capabilities.newcclosure then
		wrapped = newcclosure(hookBody)
	else
		wrapped = hookBody
	end

	local ok, original = pcall(hookmetamethod, game, "__namecall", wrapped)
	if ok and typeof(original) == "function" then
		Spy.origNamecall = original
		Spy.hookWrapper = wrapped
		Spy.hooked = true
		return true
	end
	return false
end

local function unhookNamecall()
	if not Spy.hooked then return end
	pcall(hookfunction, Spy.hookWrapper, Spy.origNamecall)
	Spy.hooked = false
	Spy.hookWrapper = nil
end

local function listenIncomingRemote(inst)
	if Spy.incoming[inst] ~= nil then return false end
	local cls = inst.ClassName
	if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" then
		local okConn, conn = pcall(function()
			return inst.OnClientEvent:Connect(function(...)
				spyRecord("Incoming", inst, "OnClientEvent", { ... })
			end)
		end)
		if okConn and conn then
			Spy.incoming[inst] = conn
			return true
		end
	elseif cls == "RemoteFunction" then
		local prev
		pcall(function() prev = inst.OnClientInvoke end)
		local okSet = pcall(function()
			inst.OnClientInvoke = function(...)
				local inArgs = { ... }
				spyRecord("Incoming", inst, "OnClientInvoke", inArgs)
				-- '...' is scoped to the vararg function only: forward via packed args
				local okPrev, prevRes = pcall(function()
					if typeof(prev) == "function" then
						return prev(table.unpack(inArgs, 1, #inArgs))
					end
					return nil
				end)
				if okPrev then return prevRes end
				return nil
			end
		end)
		if okSet then
			Spy.incoming[inst] = { invoke = true }
			table.insert(Spy.invokeCbs, { inst = inst, prev = prev })
			return true
		end
	end
	return false
end

local function attachIncoming()
	local count = 0
	local descendants
	pcall(function() descendants = game:GetDescendants() end)
	if typeof(descendants) ~= "table" then return 0 end
	local seen = 0
	for _, inst in ipairs(descendants) do
		seen = seen + 1
		if seen > 4000 then break end
		local cls = inst.ClassName
		if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" or cls == "RemoteFunction" then
			if listenIncomingRemote(inst) then count = count + 1 end
			if count >= CONFIG.RemoteIncomingCap then break end
		end
	end
	return count
end

local function detachIncoming()
	for _, conn in pairs(Spy.incoming) do
		pcall(function()
			if typeof(conn) == "RBXScriptConnection" then
				conn:Disconnect()
			end
		end)
	end
	for _, entry in ipairs(Spy.invokeCbs) do
		pcall(function()
			if typeof(entry.inst) == "Instance" and entry.inst:IsDescendantOf(game) then
				entry.inst.OnClientInvoke = entry.prev
			end
		end)
	end
	table.clear(Spy.incoming)
	table.clear(Spy.invokeCbs)
end

local function spyStart()
	local hooked = hookNamecall()
	State.spy = true
	local attached = 0
	if State.incoming then attached = attachIncoming() end
	saveState()
	return { hooked = hooked, attached = attached }
end

local function spyStop()
	unhookNamecall()
	detachIncoming()
	State.spy = false
	saveState()
end

