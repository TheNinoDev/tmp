-- COMMAND LOOP (zero-dependency file channel) ----------------------
--------------------------------------------------------------------

local LoopActive = false
local LoopThread = nil
local processedCmdIds = {}
local processedCount = 0

local function clampPollMs()
	return clamp(State.pollMs, 250, 5000)
end

local function deliverCommand(cmd)
	local fn = Commands[cmd.fn]
	if type(fn) ~= "function" then
		return { id = cmd.id, ok = false, error = "unknown command: " .. tostring(cmd.fn) }
	end
	local okCmd, cmdOut = pcall(fn, cmd.args)
	if not okCmd then
		return { id = cmd.id, ok = false, error = tostring(cmdOut or "command errored") }
	end
	if type(cmdOut) ~= "table" then
		return { id = cmd.id, ok = false, error = "bad command payload" }
	end
	if cmdOut.ok == false then
		return { id = cmd.id, ok = false, error = tostring(cmdOut.error or "command failed") }
	end
	return { id = cmd.id, ok = true, data = cmdOut.data }
end

--------------------------------------------------------------------
-- FILE CHANNEL (agent drops commands, game answers) -----------------
--------------------------------------------------------------------

local FileChannel = {
	pingAt      = 0,
	lastHandled = 0,
	handled     = 0,
}

local function writeJSONFile(name, tbl, cap)
	if not fsAvailable() then return false end
	local payload = serJSON(tbl, cap or 32768)
	return pcall(writefile, name, payload)
end

local function refreshSessionFile()
	if not fsAvailable() then return end
	local names = {}
	for _, p in ipairs(Players:GetPlayers()) do
		names[#names + 1] = p.Name
	end
	local blob = {
		rpc         = CONFIG.CmdRpcMagic,
		uuid        = State.token,
		running     = State.running,
		paused      = (not State.enabled),
		version     = VERSION,
		executor    = EXECUTOR,
		placeId     = game.PlaceId,
		gameId      = game.GameId,
		jobId       = game.JobId,
		userId      = (Players.LocalPlayer and Players.LocalPlayer.UserId) or 0,
		playerName  = (Players.LocalPlayer and Players.LocalPlayer.Name) or "",
		displayName = (Players.LocalPlayer and Players.LocalPlayer.DisplayName) or "",
		playerCount = #Players:GetPlayers(),
		players     = names,
		updatedAt   = os.time(),
	}
	writeJSONFile(sessionFileName(), blob, 4096)
end

local function maybePingSession()
	if os.time() - FileChannel.pingAt >= CONFIG.SessionPingS then
		FileChannel.pingAt = os.time()
		refreshSessionFile()
	end
end

local function writeCommandResult(id, okFlag, data, errMsg)
	return writeJSONFile(resFileName(), {
		rpc     = CONFIG.CmdRpcMagic,
		id      = id,
		ok      = okFlag,
		data    = data,
		error   = errMsg,
		session = State.token,
		time    = os.time(),
	}, 32768)
end

local function filePollCycle()
	if not fsAvailable() then return false end
	maybePingSession()

	local okIs, exists = pcall(isfile, cmdFileName())
	if not (okIs and exists) then return true end
	local okR, raw = pcall(readfile, cmdFileName())
	if not okR or type(raw) ~= "string" or #raw == 0 then return true end

	local okD, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if not okD or type(decoded) ~= "table"
		or decoded.rpc ~= CONFIG.CmdRpcMagic
		or type(decoded.id) ~= "string"
		or type(decoded.fn) ~= "string" then
		-- torn write or foreign content: leave it for the next tick
		return true
	end

	local cmd = { id = decoded.id, fn = decoded.fn, args = decoded.args }
	local cached = processedCmdIds[cmd.id]
	local out
	if cached then
		out = cached
	elseif not State.enabled then
		-- paused: explicit answer so the agent sees why nothing ran
		out = { id = cmd.id, ok = false, error = "MCP paused: toggled off in the game UI" }
		processedCmdIds[cmd.id] = out
		processedCount = processedCount + 1
	else
		out = deliverCommand(cmd)
		processedCmdIds[cmd.id] = out
		processedCount = processedCount + 1
	end
	if processedCount > 2400 then
		table.clear(processedCmdIds)
		processedCount = 0
	end

	FileChannel.handled = FileChannel.handled + 1
	FileChannel.lastHandled = os.time()
	writeCommandResult(out.id, out.ok, out.data, out.error)
	-- neutralize the answered envelope so a later dedupe-cache reset can never
	-- re-execute it: blank it first, then remove it when the executor allows
	pcall(writefile, cmdFileName(), "")
	if Capabilities.deletefile then
		pcall(delfile, cmdFileName())
	end
	return true
end

local function loopRunner()
	while LoopActive do
		pcall(filePollCycle)
		task.wait(clampPollMs() / 1000)
	end
end

local function startLoop()
	if LoopActive then return end
	LoopActive = true
	State.running = true
	LoopThread = task.spawn(loopRunner)
end

local function stopLoop()
	LoopActive = false
	State.running = false
	LoopThread = nil
end

local function setMasterEnabled(enable)
	State.enabled = enable
	saveState()
	refreshSessionFile()
	-- the loop keeps breathing while paused so pending commands still get an
	-- explicit 'paused' answer and the session file keeps the paused flag fresh
	if enable then
		startLoop()
	end
end

