local function shutdownAll(reason)
	stopLoop()
	if State.spy then
		pcall(spyStop)
	else
		pcall(detachIncoming)
	end
	State.enabled = false
	State.autoRestart = false
	State.running = false
	saveState()
	-- last session heartbeat tells the AI this run is gone (paused + not running)
	pcall(refreshSessionFile)
	pcall(function()
		if Capabilities.queue_on_teleport then
			queue_on_teleport("-- ReverseMCP stopped (" .. tostring(reason or "shutdown") .. ")")
		end
	end)
	table.clear(Spy.buffer)
	table.clear(processedCmdIds)
end

