function Commands.players(args)
	local query = (args and type(args.query) == "string") and args.query:lower() or ""
	local lp = Players.LocalPlayer
	local myRoot = lp and lp.Character and lp.Character.PrimaryPart
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local row = {
			playerId    = p.UserId,
			name        = p.Name,
			displayName = p.DisplayName,
			team        = (p.Team and p.Team.Name) or "",
			accountAge  = p.AccountAge,
			distance    = 0,
		}
		if typeof(p.Character) == "Instance" then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local hrp = p.Character.PrimaryPart
			row.characterPath = pathOf(p.Character)
			if hrp then
				local pos = hrp.Position
				row.position = { x = pos.X, y = pos.Y, z = pos.Z }
			end
			if hum then
				row.health = hum.Health
				row.maxHealth = hum.MaxHealth
				row.walkSpeed = hum.WalkSpeed
			end
			if myRoot and hrp then
				row.distance = (myRoot.Position - hrp.Position).Magnitude
			end
		end
		if query == ""
			or p.Name:lower():find(query, 1, true)
			or p.DisplayName:lower():find(query, 1, true) then
			table.insert(out, row)
		end
	end
	table.sort(out, function(a, b) return (a.distance or 0) < (b.distance or 0) end)
	return { ok = true, data = { players = out, count = #out, myPlayerId = (lp and lp.UserId) or 0 } }
end

function Commands.my_player()
	local lp = Players.LocalPlayer
	if not lp then return { ok = false, error = "LocalPlayer not ready" } end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char.PrimaryPart
	local camera = workspaceRef.CurrentCamera
	local data = {
		playerId    = lp.UserId,
		name        = lp.Name,
		displayName = lp.DisplayName,
		accountAge  = lp.AccountAge,
