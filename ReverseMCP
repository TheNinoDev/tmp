function Commands.explore(args)
	local root, err = resolvePath((args and args.path) or "game.Workspace")
	if not root then return { ok = false, error = err } end
	local depth = clamp((args and args.depth) or CONFIG.ExploreDefaults.depth, 1, CONFIG.ExploreMax.depth)
	local maxNodes = clamp((args and args.maxNodes) or CONFIG.ExploreDefaults.maxNodes, 1, CONFIG.ExploreMax.maxNodes)
	local classFilter = (args and args.classFilter and tostring(args.classFilter):lower()) or ""
	local nameFilter  = (args and args.nameFilter and tostring(args.nameFilter):lower()) or ""

	local nodes = {}
	local stack = { { inst = root, d = 0 } }
	while #stack > 0 and #nodes < maxNodes do
		local entry = table.remove(stack)
		local inst = entry.inst
		local include = true
		if classFilter ~= "" and inst.ClassName:lower():find(classFilter, 1, true) == nil then include = false end
		if include and nameFilter ~= "" and inst.Name:lower():find(nameFilter, 1, true) == nil then include = false end
		if include then
			table.insert(nodes, { path = pathOf(inst), name = inst.Name, class = inst.ClassName, depth = entry.d })
		end
		if entry.d < depth then
			local kids = inst:GetChildren()
			for chi = #kids, 1, -1 do
				table.insert(stack, { inst = kids[chi], d = entry.d + 1 })
			end
		end
	end

	return {
		ok = true,
		data = {
			root      = pathOf(root),
			depth     = depth,
			maxNodes  = maxNodes,
			count     = #nodes,
			truncated = (#nodes >= maxNodes),
			nodes     = nodes,
		},
	}
end

function Commands.search_instances(args)
	local query = (args and type(args.query) == "string") and args.query or ""
	if query == "" then return { ok = false, error = "query required" } end
	local root, err = resolvePath((args and args.path) or "game")
	if not root then return { ok = false, error = err } end
	query = query:lower()
	local classFilter = (args and args.classFilter and tostring(args.classFilter):lower()) or ""
	local limit = clamp((args and args.limit) or CONFIG.SearchLimitDefault, 1, 500)

	local results = {}
	local scanned = 0
	local truncatedNotice
	local function tryInclude(inst)
		local okName = inst.Name:lower():find(query, 1, true) ~= nil
		local okClass = (classFilter == "") or inst.ClassName:lower():find(classFilter, 1, true) ~= nil
		if okName and okClass then
			table.insert(results, { path = pathOf(inst), name = inst.Name, class = inst.ClassName })
			return true
		end
		return false
	end
	if not tryInclude(root) then
		for _, inst in ipairs(root:GetDescendants()) do
			scanned = scanned + 1
			if scanned > CONFIG.SearchScanCap then
				truncatedNotice = ("scan cap reached (%d descendants checked)"):format(CONFIG.SearchScanCap)
				break
			end
			if #results >= limit then break end
			tryInclude(inst)
		end
	end
	return { ok = true, data = { query = (args and args.query) or "", scanned = scanned, count = #results, truncatedNotice = truncatedNotice, results = results } }
end

